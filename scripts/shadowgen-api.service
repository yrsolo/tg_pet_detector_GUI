[Unit]
Description=ShadowGEN API (Jobs)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/shadowgen
EnvironmentFile=/opt/shadowgen/.env
ExecStart=/opt/shadowgen/.venv/bin/uvicorn api_server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target